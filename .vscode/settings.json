{
  // 将 tsconfig 文件识别为 JSONC（支持注释的 JSON）
  "files.associations": {
    "tsconfig*.json": "jsonc"
  },
  // 忽略 Tailwind CSS v4 自定义 at-rules 的警告（如 @theme, @source 等）
  "css.lint.unknownAtRules": "ignore",
  "js/ts.tsdk.path": "web/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true
}