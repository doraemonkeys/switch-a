  "rules": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Codex capacity",
      "enabled": true,
      "target": {
        "kind": "provider",
        "provider_id": "provider-codex"
      },
      "api_type": "codex",
      "keywords": [
        "server_is_overloaded",
        "our servers are currently overloaded at capacity"
      ],
      "match_mode": "any",
      "action": {
        "type": "retry_then_switch",
        "max_retries": 2,
        "backoff": {
          "initial_delay": "250ms",
          "max_delay": "2s",
          "multiplier": 2,
          "jitter": true
        }
      },
      "position": 0,
      "created_at": "2026-08-03T01:02:03Z",
      "updated_at": "2026-08-03T01:02:03Z"
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Observe upstream maintenance",
      "enabled": true,
      "target": {
        "kind": "global"
      },
      "api_type": null,
      "keywords": ["maintenance window"],
      "match_mode": "all",
      "action": {
        "type": "passthrough"
      },
      "position": 1,
      "created_at": "2026-08-03T01:03:00Z",
